# ── Host bind-mount roots (portability) ─────────────────────────────────
# These DEFAULT to relative paths, so a normal clone (macOS/Linux/Windows)
# works with NO changes — leave them commented out.
# ONLY the Windows worktree dev flow (running from .claude/worktrees/<name>)
# needs to override them to point at the MAIN repo, e.g.:
#   HOST_REPO_ROOT=C:/ai-projects/claude-agent-team   # repo root (default ".")
#   HOST_PROJECTS_ROOT=C:/ai-projects                 # repo's parent (default "..")
# HOST_REPO_ROOT=.
# HOST_PROJECTS_ROOT=..

# ── Claude Platform on AWS — single LLM provider for all agents ─────────
# This project uses Claude Platform on AWS (NOT Amazon Bedrock, NOT the direct
# Anthropic API). Anthropic operates the inference stack; AWS provides auth
# and billing through AWS Marketplace.
#
# How to set this up:
#   1. Sign up at AWS Console → Claude Platform on AWS
#   2. One-time per AWS account:  aws iam enable-outbound-web-identity-federation
#   3. Generate a long-term API key in AWS Console → Claude Platform on AWS → API keys
#   4. Note your workspace ID (format wrkspc_...) from the Workspaces page
#   5. Paste the values below
#
# Full setup guide: docs/setup-claude-platform-on-aws.md
ANTHROPIC_AWS_API_KEY=
ANTHROPIC_AWS_WORKSPACE_ID=wrkspc_xxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# Database (platform state — requests, subtasks, etc.)
DATABASE_URL=sqlite:///data/agent_team.db

# ── Knowledge Base datastore (KB-01) — Postgres + pgvector ──────────────
# Separate from the SQLite platform DB above. Holds the agentic knowledge
# base (kb_documents, kb_chunks, decision_ledger) + vector embeddings.
# The backend reaches the postgres container at host `postgres` on dev-net.
# KB_PG_PASSWORD is also available as a Docker secret (secrets/kb_pg_password.txt).
KB_PG_HOST=postgres
KB_PG_PORT=5432
KB_PG_USER=agentteam
KB_PG_PASSWORD=change-me-in-dev
KB_PG_DB=agentteam_kb

# ── Voyage AI (KB embeddings + rerank) — swappable behind the Embedder interface ──
# Get a key at https://dash.voyageai.com. Also accepted as a Docker secret
# (secrets/voyage_api_key.txt). Leave blank to run the KB in degraded mode
# (no retrieval) — the backend still boots.
VOYAGE_API_KEY=

# GitHub Integration (PAT with contents:write scope, used by ResearchPublisher)
GITHUB_TOKEN=ghp_xxxxx
GITHUB_REPO=cmuthu2503-ai/claude-agent-team
GITHUB_BRANCH=main

# Firecrawl (used by web_search and web_scrape tools — gives agents live web access)
FIRECRAWL_API_KEY=fc-xxxxx

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG
