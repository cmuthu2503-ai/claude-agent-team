# ── Claude Platform on AWS — single LLM provider for all agents ─────────
# This project uses Claude Platform on AWS (NOT Amazon Bedrock, NOT the direct
# Anthropic API). Anthropic operates the inference stack; AWS provides auth
# and billing through AWS Marketplace.
#
# How to set this up:
#   1. Sign up at AWS Console → Claude Platform on AWS
#   2. One-time per AWS account:  aws iam enable-outbound-web-identity-federation
#   3. Generate a long-term API key in AWS Console → Claude Platform on AWS → API keys
#   4. Note your workspace ID (format wrkspc_...) from the Workspaces page
#   5. Paste the values below
#
# Full setup guide: docs/setup-claude-platform-on-aws.md
ANTHROPIC_AWS_API_KEY=
ANTHROPIC_AWS_WORKSPACE_ID=wrkspc_xxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# Database
DATABASE_URL=sqlite:///data/agent_team.db

# GitHub Integration (PAT with contents:write scope, used by ResearchPublisher)
GITHUB_TOKEN=ghp_xxxxx
GITHUB_REPO=cmuthu2503-ai/claude-agent-team
GITHUB_BRANCH=main

# Firecrawl (used by web_search and web_scrape tools — gives agents live web access)
FIRECRAWL_API_KEY=fc-xxxxx

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG
